{
  "schema_version": 2,
  "arena": "<arena>",
  "components": ["slm", "harness", "router", "escalation"],
  "hardware_class": "mt-5",
  "profile": "P1",
  "weights_sha256": "<sha256 over the sorted weight file digests>",
  "image_digest": "sha256:<the runner image digest from the arena definition>",
  "slm": {
    "repo": "<user>/mt_slm_<arena>",
    "revision": "<40 hex git commit sha>",
    "files": {"model.safetensors": "sha256:...", "config.json": "sha256:..."}
  },
  "files": {
    "config.json": "sha256:...",
    "main.py": "sha256:...",
    "requirements.txt": "sha256:...",
    "router/config.json": "sha256:...",
    "router/model.safetensors": "sha256:...",
    "harness/engine.py": "sha256:...",
    "harness/verifier.py": "sha256:...",
    "harness/adapters/__init__.py": "sha256:...",
    "harness/prompts/generic/task.txt": "sha256:...",
    "escalation/patcher.py": "sha256:..."
  }
}
